NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pyqdeck
CORS_ORIGIN=*
LOG_LEVEL=info

# Clerk - use the SAME instance/keys as the main PYQDeck server
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create for THIS server in the Clerk dashboard
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Comma separated; verified Clerk emails that get the admin role on first sign-in
COMMUNITY_ADMIN_EMAILS=
