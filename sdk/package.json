{
  "name": "@pyqdeck/community-sdk",
  "version": "0.3.0",
  "description": "Typed client for the PYQDeck Community API (posts, comments, members, short links). No Clerk, React or cache inside: the app supplies the token and owns caching.",
  "keywords": [
    "pyqdeck",
    "community",
    "sdk",
    "react-native",
    "expo",
    "tanstack-query"
  ],
  "license": "MIT",
  "author": "Raiyan Hasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanraiyan/pyqdeck-community.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/hasanraiyan/pyqdeck-community/tree/master/sdk#readme",
  "bugs": "https://github.com/hasanraiyan/pyqdeck-community/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "~6.0.0"
  }
}
