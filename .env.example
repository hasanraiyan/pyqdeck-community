NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pyqdeck
CORS_ORIGIN=*
LOG_LEVEL=info

# Clerk - use the SAME instance/keys as the main PYQDeck server
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create for THIS server in the Clerk dashboard
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Comma separated; verified Clerk emails that get the admin role on first sign-in
COMMUNITY_ADMIN_EMAILS=

# 32 random bytes, base64:  openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=
STORAGE_HEADROOM_PERCENT=5

# OpenAI Moderation API (text + image moderation). Required in production.
OPENAI_API_KEY=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=8000

# --- Communities and short links ---
# Communities created on boot when missing (comma separated). More can be added at runtime by a platform admin.
SEED_COMMUNITIES=beu
# Which hosts this process serves: all (selected by hostname) | api | links
SERVE_MODE=all
# Hostname that serves short links; point its DNS at this service.
LINK_HOST=go.pyqdeck.in
LINK_CODE_LENGTH=8
LINK_RECHECK_HOURS=24
# Reverse proxies in front of the app (Render = 1) so req.ip and req.hostname are the real client values.
TRUST_PROXY=0
# Multiplies every rate limit. Leave at 1 in production.
RATE_LIMIT_SCALE=1

# --- Image storage (optional): one Cloudinary account from the environment ---
# Set all three and it is created on boot as the storage account "cloudinary-env" (keys are updated if you change them).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Soft limit in GB; keep it a little below your plan's real limit.
CLOUDINARY_CAPACITY_GB=2

# --- Local word filter (runs before the moderation API; a hit is refused without calling it) ---
PROFANITY_FILTER=true
# Comma separated, lower case. Extra words to block / words from the library's list to allow.
PROFANITY_EXTRA_WORDS=
PROFANITY_ALLOWED_WORDS=
